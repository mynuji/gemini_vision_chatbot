# 이 파일을 .env로 복사한 뒤 실제 키를 입력하세요: cp server/.env.example server/.env
GEMINI_API_KEY=your-gemini-api-key
# 주 모델 (gemini-1.5/2.5 계열은 신규 사용자에게 종료됨)
GEMINI_MODEL=gemini-3.5-flash
# 주 모델 과부하(503)/할당량 초과(429) 시 순서대로 시도할 대체 모델
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# 사고 수준: minimal | low | medium | high (모델이 거부하면 서버가 자동으로 기본 설정으로 재시도)
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=1024
